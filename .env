# Media: site /media/<filename> 302-proxies to the CMS public, tenant-scoped media endpoint.
# Prod: https://cms.bedigital.ai/media (dev: http://localhost:3000/media). The CMS redirects on to
# Supabase Storage (bucket cms-media). HISTORICAL: earlier R2/MEDIA_STORAGE=r2 note no longer applies.
MEDIA_PUBLIC_BASE=https://cms.bedigital.ai/media
MEDIA_TENANT_SLUG=izzi-beauty

# Forms: where <Form> POSTs submissions (the CMS origin). Empty = same-origin (404 in dev).
NEXT_PUBLIC_FORMS_ENDPOINT=https://cms.bedigital.ai

# Commerce: 1 = de shop-routes bestaan op deze site, 0 = ze geven 404. De geheime
# storefront-sleutel (COMMERCE_API_KEY) staat NIET in dit bestand — die zet provisioning
# rechtstreeks op het Vercel-project, omdat deze .env in de repo van de klant wordt gecommit.
NEXT_PUBLIC_COMMERCE_ENABLED=0
